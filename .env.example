# Canonical absolute site URL (no trailing slash), used for metadata,
# canonical tags, Open Graph, sitemap, and robots.
#
# OPTIONAL. On Vercel this is auto-detected from the deployment's own domain,
# so you usually don't need to set it. Set it only to pin a specific canonical
# URL — e.g. your custom domain once you add one. Must include the protocol.
# NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com
